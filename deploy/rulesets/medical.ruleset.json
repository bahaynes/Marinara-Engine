      },
      {
        "id": "athletics",
        "label": "Athletics",
        "ability": "str"
      },
      {
        "id": "endurance",
        "label": "Endurance",
        "ability": "con"
      }
    ],
    "fields": [
      {
        "id": "level",
        "label": "Level",
        "type": "number",
        "min": 1,
        "max": 20,
        "default": 1,
        "section": "identity"
      },
      {
        "id": "class",
        "label": "Class",
        "type": "text",
        "maxLength": 80,
        "section": "identity"
      },
      {
        "id": "hp_max",
        "label": "Hit points",
        "type": "number",
        "min": 1,
        "max": 999,
        "default": 10,
        "section": "identity"
      }
    ],
    "derived": [
      {
        "id": "proficiency_bonus",
        "label": "Proficiency bonus",
        "op": "stepTable",
        "from": {
          "field": "level"
        },
        "table": [
          [
            1,
            2
          ],
          [
            5,
            3
          ],
          [
            9,
            4
          ],
          [
            13,
            5
          ],
          [
            17,
            6
          ]
        ],
        "section": "identity"
      }
    ],
    "lists": [],
    "live": {
      "pools": [
        {
          "id": "hp",
          "label": "Hit points",
          "max": {
            "field": "hp_max"
          },
          "allowTemp": true
        },
        {
          "id": "inspiration",
          "label": "Inspiration",
          "max": {
            "const": 4
          },
          "start": "empty",
          "startFrom": {
            "const": 1
          }
        }
      ]
    }
  },
  "rests": [],
  "gm": {
    "checkGuidance": "This game uses a medical-drama ruleset. Call for a skill check only when the outcome is uncertain and failure is interesting. Name the skill and set a DC. Never add modifiers or state a total: the Engine applies the character sheet and reports the outcome.",
    "sheetGuidance": "The character sheets are authoritative."
  }
}
