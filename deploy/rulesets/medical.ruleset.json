      },
      {
        "id": "wis_save",
        "label": "Wisdom save",
        "ability": "wis"
      },
      {
        "id": "cha_save",
        "label": "Charisma save",
        "ability": "cha"
      }
    ],
    "saveTiers": [
      "none",
      "proficient"
    ],
    "skills": [
      {
        "id": "diagnostics",
        "label": "Diagnostics",
        "ability": "int"
      },
      {
        "id": "investigation",
        "label": "Investigation",
        "ability": "int"
      },
      {
        "id": "triage",
        "label": "Triage",
        "ability": "wis"
      },
      {
        "id": "perception",
        "label": "Perception",
        "ability": "wis"
      },
      {
        "id": "insight",
        "label": "Insight",
        "ability": "wis"
      },
      {
        "id": "bedside_manner",
        "label": "Bedside Manner",
        "ability": "cha"
      },
      {
        "id": "hospital_politics",
        "label": "Hospital Politics",
        "ability": "cha"
      },
      {
        "id": "persuasion",
