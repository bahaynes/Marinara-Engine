# ─────────────────────────────────────────────────────────────────────────────
# Marinara Engine — Cloudflare Deployment Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env in deploy/gcp/ before running docker compose.
#
#   cp deploy/gcp/.env.cloud.example deploy/gcp/.env
# ─────────────────────────────────────────────────────────────────────────────

# 1. Cloudflare Tunnel Token
# Create a tunnel in Cloudflare Zero Trust (Networks > Tunnels > Add a tunnel),
# select "Docker", and copy the token from the run command.
# In the tunnel's "Public Hostname" tab, add:
#   Service: HTTP
#   URL:     marinara:7860
TUNNEL_TOKEN=eyJhIjoi...

# 2. Hostname & CSRF Protection
# Set to your full tunnel domain (e.g. marinara.example.com).
# CSRF_TRUSTED_ORIGINS must include the https:// scheme.
TRUSTED_HOSTS=marinara.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://marinara.yourdomain.com

# 3. HTTP Basic Authentication
# Protects your instance when accessed over the public Cloudflare tunnel.
# Pick a strong password: `openssl rand -base64 24`
BASIC_AUTH_USER=nomad
BASIC_AUTH_PASS=change-me-to-a-secure-password

# 4. Admin Access Secret
# Needed to access sensitive browser settings, imports, and exports remotely.
# Generate: `openssl rand -hex 32`
# Paste this same secret into Settings > Advanced > Admin Access in the UI.
ADMIN_SECRET=generate-random-secret-here

# 5. Local Storage & Preferences
MARINARA_DATA_DIR=./marinara-data
PORT=7860
TZ=America/New_York
AUTO_CREATE_DEFAULT_CONNECTION=true

